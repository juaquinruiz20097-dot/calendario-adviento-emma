iv id="spinnerBlock" style="display:none;" class="spinner-container" align="center" data-bind="visible: searchViewModel.isProcessing()"> <div class="spinner"></div> <p data-bind="text: translationsProvider.GetTranslations().searchViewModel.spinnerText"></p> </div> <div id="mediaInfoBlock" style="display:none;" data-bind="visible: searchResultViewModel.isVisible()"> <div id="previewImage"> <img src="https://static.freemake.com/frm/images/pixel.png" style="width:100%;" alt="preview image" data-bind="attr:{src: searchResultViewModel.thumbnail}"> </div> <div id="mediaInfoDescription"> <div id="title"> <p data-bind="text: searchResultViewModel.title"></p> </div> <div id="duration"> <p> <span id="durationText">Duración: </span> <span id="durationValue" data-bind="text: searchResultViewModel.duration"></span> </p> </div> </div> <div id="qualitiesBlock" data-bind="css: { 'disabled-block': !searchResultViewModel.isEnabled() }"> <dl class="dropdown"> <dt> <div class="wrapper"> <span id="selectedItem" data-bind="click: searchResultViewModel.clickQualityCommand, css: { 'arrow-down-background': !searchResultViewModel.isDropDownVisible(), 'arrow-up-background': searchResultViewModel.isDropDownVisible() }"> <div data-bind="attr:{id: searchResultViewModel.selectedMedia().mediaModel.url}" class="dditem tv-android-ios-images"> <span class="partdditem titletype" data-bind="text: searchResultViewModel.selectedMedia().mediaModel.type"></span> <span class="partdditem hdlabel"><sup data-bind="visible: searchResultViewModel.selectedMedia().mediaModel.isHD">HD</sup></span> <span class="partdditem quality" data-bind="text: searchResultViewModel.selectedMedia().mediaModel.quality"></span> <span class="partdditem size" data-bind="text: searchResultViewModel.selectedMedia().mediaModel.size"></span> <span class="partdditem format" data-bind="text: searchResultViewModel.selectedMedia().mediaModel.format"></span> </div> </span> </div> </dt> <dd> <ul id="qualities" data-bind="foreach: searchResultViewModel.mediaList, visible: searchResultViewModel.isDropDownVisible()"> <li> <div class="option" data-bind="css: {selected: isSelected}"> <div class="dditem tv-android-ios-images" data-bind="click: $root.searchResultViewModel.selectQuality"> <span class="partdditem titletype" data-bind="text: mediaModel.type"></span> <span class="partdditem hdlabel"><sup data-bind="visible: mediaModel.isHD">HD</sup></span> <span class="partdditem quality" data-bind="text: mediaModel.quality"></span> <span class="partdditem size" data-bind="text: mediaModel.size"></span> <span class="partdditem format" data-bind="text: mediaModel.format"></span> </div> </div> </li> </ul> </dd> </dl> </div> <div id="ff-merge-view-model" class="ff-merge-view-model" data-bind="visible: cascadeDownloadViewModel.isVisible()"> <div class="ff-merge-view-model__progress-bar"> <div class="ff-merge-view-model__progress" data-bind="style:{ width: cascadeDownloadViewModel.progressFormat }, css: { 'ff-merge-view-model__progress-animate': cascadeDownloadViewModel.isProcessing }"> <span class="ff-merge-view-model__percentage" data-bind="text: cascadeDownloadViewModel.progressFormat">0%</span> </div> </div> <div class="ff-merge-view-model__progress-message-container"> <span class="ff-merge-view-model__progress-message" data-bind="text: cascadeDownloadViewModel.preparingForDownloadMessage, visible: cascadeDownloadViewModel.isProcessing"></span> <span data-bind="visible: cascadeDownloadViewModel.isSuccessMerge() || cascadeDownloadViewModel.isFailMerge()"> <span class="ff-merge-view-model__progress-message" data-bind="text: cascadeDownloadViewModel.readyFileMessage"></span> <a class="ff-merge-view-model__download-file-btn" href="#" data-bind="click: function() { cascadeDownloadViewModel.downloadFile($root.searchResultViewModel.title()) }, text: cascadeDownloadViewModel.downloadButtonText" rel="nofollow"></a> </span> </div> </div> <div id="cascade-external-download" class="ff-merge-view-model" data-bind="visible: cascadeDownloadViewModel.isExternalVisible()"> <div class="ff-merge-view-model__progress-bar" data-bind="visible: cascadeDownloadViewModel.isExternalProgressVisible()"> <div class="ff-merge-view-model__progress--endless"></div> </div> <div class="ff-merge-view-model__error-message" data-bind="visible: cascadeDownloadViewModel.isExternalErrorVisible()"> <img src="https://static.freemake.com/frm/images/alert/ic-alert.svg" style="vertical-align:baseline;" class="service_alert" alt="alert icon"> <p style="display: inline;">Enlace inválido. Por favor inserte otro enlace de YouTube</p> </div> </div> </div> <div data-bind="click: DownloadClickCommand, style: { 'pointer-events': searchViewModel.isProcessing() ? 'none' : 'auto' }, 'visible': isDownloadButtonVisible" title="Obtener" class="topblock__download white fontsize4 text-center center-block download fvd-download-link-patch">Descargar ahora</div> </div> <div class="topblock__text text-center" style="font-weight: 700;"> Seguido por 93 millones de fans. <span>YouTube Downloader</span> #1 durante 10 años. </div> <div class="topblock__text text-center"> Freemake Video Downloader permite descargar vídeos de YouTube y 10,000 + sitios web. Bajar vídeos de YouTube gratis en 1080 HD, MP4, MP3, AVI, 3GP, FLV, etc. 100% gratis, sin limite, en Español! </div> <p class="version text-center">Versión 6.0.1 (historial)</p> <div class="topblock__social"> <ul class="text-center"> <li> <a href="https://www.facebook.com/Freemake" rel="nofollow noopener noreferrer" target="_blank" class="clearfix" onclick="SendSocialButtonClickEvent('socButtonFacebook');"> <span class="topblock__social-facebook">Facebook</span> </a> </li> <li> <a href="https://twitter.com/Freemakecom" rel="nofollow noopener noreferrer" target="_blank" class="clearfix" onclick="javascript:SendSocialButtonClickEvent('socButtonTwitter');"> <span class="topblock__social-twitter">Twitter</span> </a> </li> </ul> </div> </div> </div> </div> <div class="counter container"> <div class="row-fluid"> <div class="white text-center centerwrap"> Freemake ya tiene 93,667,304 de usuarios </div> </div> </div> <div class="supported container"> <div class="row-fluid"> <div class="centerwrap"> <div class="supported-block__title"> <h2 class="fontsize5">Descargar vídeos de YouTube</h2> </div> <div class="supported-block__text">Free YouTube Downloader permite descargar vídeos de YouTube en formato original: 1080 MP4, AVI, <a href="https://m.freemake.com/es/how_to/how_to_convert_mkv_to_avi_mp4/" target="_blank">MKV</a>, <a href="https://m.freemake.com/es/how_to/how_to_convert_wmv_para_mp4_free/" target="_blank">WMV</a>, FLV, 3GP, WebM. Bajar solo la música de los vídeos de YouTube. Descargar varios vídeos a la vez. Descargar vídeos de YouTube para reproducirlos en tu PC, iPhone, Android, PSP, Amazon Kindle Fire, tableta, celular.</div> </div> </div> </div> <div class="supported-info container first"><div class="row-fluid"> <div class="centerwrap"><div class="supported-block__link-see">Formatos de YouTube soportados</div><div class="supported-info__header">Formatos para descarga directa</div></div> <div class="line centerwrap"><div></div></div> <div class="list centerwrap"> <div class="supported-info__content fontsize2"><ul><li>MP4 Ultra HD 4K</li><li>MP4 HD 1440p</li><li>MP4 HD 1080p</li><li>MP4 HD 720p</li><li>MP4 480p</li><li>MP4 360p</li><li>MP4 360p (Apple ready)</li><li>WebM 360p</li><li>FLV 240p</li><li>3GP 240p</li><li>MP4 180p</li><li>3GP 180p</li></ul></div> </div> </div><div class="row-fluid"> <div class="centerwrap"><div class="supported-info__header">Formatos de conversión</div></div> <div class="line centerwrap"><div></div></div> <div class="list centerwrap"> <div class="supported-info__content fontsize2"><ul><li>AVI</li><li>MP3</li><li>WMV</li><li>MKV</li><li>3GP</li><li>iPod/iPhone</li><li>iPad</li><li>Android</li><li>PSP</li></ul></div> </div> </div><div class="row-fluid"> <div class="whitewrap"> <div class="blockline centerwrap"><div> </div> </div> </div> </div> </div><div class="supported container"> <div class="row-fluid"> <div class="centerwrap"> <div class="supported-block__title"> <h2 class="fontsize5">Descargar vídeo de 10.000 sitios</h2> </div> <div class="supported-block__text">Descargar vídeos de YouTube, Facebook, Vimeo, Twitch, Dailymotion, LiveLeak, Flickr, páginas locales y sitios para adultos. Bajar vídeos musicales, conciertos, series, música, películas, anime, noticias, tutoriales, programas de TV, dibujos animados, videos graciosos, vídeos deportivos e educativos de Internet.</div> </div> </div> </div> <div class="supported-info container second"><div class="row-fluid"> <div class="centerwrap"><div class="supported-block__link-see">Sitios soportados</div><div class="supported-info__header">Sitios populares</div></div> <div class="line centerwrap"><div></div></div> <div class="list centerwrap"> <div class="supported-info__content fontsize2"><ul class="supported-info__topsites"><li><em class="supported-info_topsites-01"></em> YouTube</li><li><em class="supported-info_topsites-02"></em> Facebook</li><li><em class="supported-info_topsites-03"></em> Vimeo</li><li><em class="supported-info_topsites-04"></em> Dailymotion</li></ul><ul class="supported-info__topsites"><li><em class="supported-info_topsites-05"></em> LiveLeak</li><li><em class="supported-info_topsites-06"></em> Veoh</li><li><em class="supported-info_topsites-07"></em> Flickr</li><li><em class="supported-info_topsites-08"></em> PBS video</li></ul></div> </div> </div><div class="row-fluid"> <div class="centerwrap"><div class="supported-info__header">Sitios locales</div></div> <div class="line centerwrap"><div></div></div> <div class="list centerwrap"> <div class="supported-info__content fontsize2"><ul class="supported-info__local"><li>Nicovideo.jp</li><li>VK.com</li><li>Say-move.org</li><li>Video.fc2.com</li><li>Bilibili.com</li><li>Jp.channel.pandora.tv</li><li>Anitube.se</li><li>Tudou.com</li></ul><ul class="supported-info__local"><li>Himado.in</li><li>Youku.com</li><li>Mgoon.com</li><li>Lemonde.fr</li><li>Sportstadio.it</li><li>Video.repubblica.it</li><li>Notizie.virgilio.it</li><li>Video.mediaset.it</li></ul></div> </div> </div><div class="row-fluid"> <div class="centerwrap"><div class="supported-info__header">Sitios para adultos</div></div> <div class="line centerwrap"><div></div></div> <div class="list centerwrap"> <div class="supported-info__content fontsize2"><img src="https://static.freemake.com/frm/images/products/FVD/adult-sites.png" alt="Supported Adult Websites"/></div> </div> </div><div class="row-fluid"> <div class="whitewrap"> <div class="blockline centerwrap"><div> </div> </div> </div> </div> </div><div class="supported container"> <div class="row-fluid"> <div class="centerwrap"> <div class="supported-block__title"> <h2 class="fontsize5">Bajar contenido de YouTube</h2> </div> <div class="supported-block__text">Obtener listas de reproducción y canales de YouTube. Bajar vídeos en 4K, Full HD, HD de forma rápida y fácil. El programa mostrará el tamaño del archivo antes de su descarga. Descargue hasta 500 archivos a la vez! Instale nuestro Freemake <a href="https://m.freemake.com/es/free_youtube_converter/" target="_blank">YouTube Boom</a> para buscar y descargar música de YouTube.</div> </div> </div> </div> <div class="supported-info container third"><div class="row-fluid"> <div class="centerwrap"><div class="supported-block__link-see">Contenido soportado</div><div class="supported-info__header">Contenido soportado</div></div> <div class="line centerwrap"><div></div></div> <div class="list centerwrap"> <div class="supported-info__content fontsize2"><ul> <li>Vídeos de YouTube</li> <li>Vídeos de YouTube Vevo</li> <li>Vídeos favoritos de YouTube</li> <li>Canales de YouTube</li> <li>Vídeo de YouTube insertado</li> <li>Vídeos de YouTube privados</li> </ul></div> </div> </div><div class="row-fluid"> <div class="whitewrap"> <div class="blockline centerwrap"><div> </div> </div> </div> </div> </div> <div class="supported-block-resume container"> <div class="row-fluid"> <div class="wrapblock centerwrap"> <div class="supported-block__title"> <h2 class="fontsize5"> Descargador de vídeos más rápido </h2> </div> <div class="supported-block__text"> Descarga vídeos de YouTube a la máxima velocidad. Sólo se tarda <span>4 minutos</span> para descargar una película de dos horas en 1080 Full HD! </div> <a title="Obtener" href="https://www.freemake.com/es/download?id=FreemakeVideoDownloader.exe" data-download-fvd-btn-analytics-id="1button" class="white fontsize4 text-center center-block download fvd-download-link-patch" rel="nofollow">Descargar Ahora</a> </div> </div> </div> <div class="feautures container"> <div class="row-fluid"> <div class="wrapblock centerwrap"> <div class="feautures-block text-center"> <div class="feautures-icon"> <img class="center-block" src="https://static.freemake.com/frm/images/products/download-4k-full-hd-freemake.png" alt="Descargar video youtube 4K & Full HD"> </div> <div class="feautures-block__title"> <h3 class="fontsize5">Descargar 4K & Full HD</h3> </div> <div class="feautures-block__text">Ingrese la URL y seleccione la calidad deseada de la lista (4K, 1440p, 1080p, 720p, 480p, 360p, 240p, 180p) para descargar archivos de YouTube en calidad original.</div> </div><div class="feautures-block text-center"> <div class="feautures-icon"> <img class="center-block" src="https://static.freemake.com/frm/images/products/download-video-playlists-freemake.png" alt="Descargar listas de reproducción"> </div> <div class="feautures-block__title"> <h3 class="fontsize5">Descargar listas de reproducción</h3> </div> <div class="feautures-block__text">Descargar todos los vídeos de una lista de reproducción o un canal de YouTube. <a href="https://m.freemake.com/es/how_to/how_to_get_youtube_songs_to_itunes/" target="_blank">Bajar música de YouTube</a> para celular, PC. Descargue hasta 500 archivos a la vez.</div> </div><div class="feautures-block text-center"> <div class="feautures-icon"> <img class="center-block" src="https://static.freemake.com/frm/images/products/download-any-video-quality-freemake.png" alt="Elegir la calidad"> </div> <div class="feautures-block__title"> <h3 class="fontsize5">Elegir la calidad deseada</h3> </div> <div class="feautures-block__text">Seleccione entre 15 calidades disponibles en YouTube, incluyendo Ultra HD 4K y Full HD. Elija la calidad deseada y guarde el fichero en su PC en el formato <a href="https://m.freemake.com/es/how_to/how_to_convert_mov_to_avi_mp4/" target="_blank">MP4</a>, AVI, etc.</div> </div><div class="feautures-block text-center"> <div class="feautures-icon"> <img class="center-block" src="https://static.freemake.com/frm/images/products/limit-download-speed-freemake.png" alt="Limitar la velocidad"> </div> <div class="feautures-block__title"> <h3 class="fontsize5">Limitar la velocidad de descarga</h3> </div> <div class="feautures-block__text">Limite la velocidad de descarga hasta 8Mbps, 4MBps, 2MBps, 1MBps, 700 KBps, si su conexión a Internet es lenta.</div> </div><div class="feautures-block text-center"> <div class="feautures-icon"> <img class="center-block" src="https://static.freemake.com/frm/images/products/video-download-options-freemake.png" alt="Utilizar proxy y control parental"> </div> <div class="feautures-block__title"> <h3 class="fontsize5">Utilizar proxy y control parental</h3> </div> <div class="feautures-block__text">Descargar video de YouTube de forma anónima utilizando un servidor proxy. Control parental, historial de descargas, restauración de descargas interrumpidas.</div> </div><div class="feautures-block text-center"> <div class="feautures-icon"> <img class="center-block" src="https://static.freemake.com/frm/images/products/video-download-to-cloud-freemake.png" alt="Guardar en la nube"> </div> <div class="feautures-block__title"> <h3 class="fontsize5">Guardar en la nube</h3> </div> <div class="feautures-block__text">Seleccione Dropbox, Google Drive o OneDrive como destino de archivos multimedia. El programa <a href="https://m.freemake.com/es/how_to/how_to_compress_video/" target="_blank">comprime archivos</a> sin perder calidad.</div> </div> <a title="Obtener" href="https://www.freemake.com/es/download?id=FreemakeVideoDownloader.exe" data-download-fvd-btn-analytics-id="2button" class="white fontsize4 text-center center-block download fvd-download-link-patch" rel="nofollow">Descargar Ahora</a> </div> </div> </div> <div class="best-converter container"> <div class="row-fluid"> <div class="wrapblock centerwrap"> <div class="best-converter__title text-center"> <h2 class="fontsize5"> Freemake es el mejor descargador de vídeo. ¿Por qué? </h2> </div> <div class="best-converter__text"> <div class="best-converter__wrap best-converter__wrap--awards"> <span class="fontbold fontsize3"></span><span>93 millones</span> de usuarios </div> <div class="best-converter__wrap best-converter__wrap--awards"> <span class="fontbold fontsize3"></span> <p class="best-converter__desk"><span>500+</span> premios de expertos</p> </div> <div class="best-converter__wrap best-converter__wrap--years"> <p class="best-converter__desk"><span>10 años</span> de seguridad</p> <span class="fontbold fontsize3"></span> </div> </div> <div class="best-converter__textblock"> <img src="https://static.freemake.com/mbl/images/fast-video-converter.png" alt="Descargas rápidas y en alta calidad"> <div class="best-converter__textblock-title"> <h3 class="fontsize5">Más rápido</h3> </div> <div class="best-converter__textblock-text"> Descargar archivos rápidamente. Sin límites, sin publicidad. Absolutamente gratis! </div> </div> <div class="best-converter__textblock"> <img src="https://static.freemake.com/mbl/images/easy-video-converter.png" alt="Súper fácil video downloader"> <div class="best-converter__textblock-title"> <h3 class="fontsize5">Súper fácil</h3> </div> <div class="best-converter__textblock-text"> La simplicidad de Freemake es increíble. Sólo dos cl